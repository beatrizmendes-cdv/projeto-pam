  "components": {
    "schemas": {
      "PointCoordinatesDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "Point",
            "enum": [
              "Point"
            ]
          },
          "coordinates": {
            "example": [
              -38.523,
              -3.731
            ],
            "minItems": 2,
            "maxItems": 2,
            "description": "Array com [longitude, latitude]",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "CreateTurbineDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da turbina",
            "example": "Turbina 1"
          },
          "coordinates": {
            "description": "Localização no formato GeoJSON",
            "allOf": [
              {
                "$ref": "#/components/schemas/PointCoordinatesDto"
              }
            ]
          },
          "simulation_id": {
            "type": "number",
            "nullable": true,
            "description": "ID da simulacão a qual a turbina pertence",
            "example": 1
          },
          "turbine_catalog_id": {
            "type": "number",
            "description": "ID do catálogo de turbina ao qual a turbina pertence",
            "example": 1
          }
        },
        "required": [
          "name",
          "coordinates",
          "turbine_catalog_id"
        ]
      },
      "ResponseTurbineDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Turbina 1"
          },
          "coordinates": {
            "$ref": "#/components/schemas/PointCoordinatesDto"
          },
          "turbine_catalog_id": {
            "type": "number",
            "example": 1
          },
          "simulation_id": {
            "type": "number",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "name",
          "coordinates",
          "turbine_catalog_id",
          "simulation_id"
        ]
      },
      "UpdateTurbineDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da turbina",
            "example": "Turbina 1"
          },
          "coordinates": {
            "description": "Localização no formato GeoJSON",
            "allOf": [
              {
                "$ref": "#/components/schemas/PointCoordinatesDto"
              }
            ]
          },
          "turbine_catalog_id": {
            "type": "number",
            "description": "ID do catálogo de turbina ao qual a turbina pertence",
            "example": 1
          }
        }
      },
      "CreateTurbineCatalogDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do modelo de turbina",
            "example": "Turbina X"
          },
          "nominal_power": {
            "type": "number",
            "description": "Potencia do modelo de turbina",
            "example": 1000
          },
          "rotor_diameter": {
            "type": "number",
            "description": "Diâmetro do rotor do modelo de turbina",
            "example": 50
          },
          "manufacturer": {
            "type": "string",
            "description": "Fabricante do modelo de turbina",
            "example": "Fabricante X"
          }
        },
        "required": [
          "name",
          "nominal_power",
          "rotor_diameter",
          "manufacturer"
        ]
      },
      "ResponseTurbineCatalogDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do modelo de turbina",
            "example": "Turbina X"
          },
          "nominal_power": {
            "type": "number",
            "description": "Potencia do modelo de turbina",
            "example": 1000
          },
          "rotor_diameter": {
            "type": "number",
            "description": "Diâmetro do rotor do modelo de turbina",
            "example": 50
          },
          "manufacturer": {
            "type": "string",
            "description": "Fabricante do modelo de turbina",
            "example": "Fabricante X"
          },
          "id": {
            "type": "number",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-09-30T12:00:00.000Z"
          }
        },
        "required": [
          "name",
          "nominal_power",
          "rotor_diameter",
          "manufacturer",
          "id",
          "created_at"
        ]
      },
      "UpdateTurbineCatalogDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do modelo de turbina",
            "example": "Turbina X"
          },
          "nominal_power": {
            "type": "number",
            "description": "Potencia do modelo de turbina",
            "example": 1000
          },
          "rotor_diameter": {
            "type": "number",
            "description": "Diâmetro do rotor do modelo de turbina",
            "example": 50
          },
          "manufacturer": {
            "type": "string",
            "description": "Fabricante do modelo de turbina",
            "example": "Fabricante X"
          }
        }
      },
      "CreateSimulationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da simulacao",
            "example": "Simulacao 1"
          },
          "turbine_ids": {
            "description": "id das turbinas",
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "turbine_ids"
        ]
      },
      "ResponseSimulationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Simulacao 1"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "UpdateSimulationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da simulacao",
            "example": "Simulacao 1"
          }
        }
      }
    }
  }
